{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/stats.js",
            "destination": "https://cloud.umami.is/script.js"
        },
        {
            "source": "/api/send",
            "destination": "https://gateway.umami.is/api/send"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
